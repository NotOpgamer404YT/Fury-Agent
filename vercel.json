{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/v1/tasks/[id]/step/route.ts": { "maxDuration": 60 },
    "src/app/api/v1/tasks/[id]/messages/route.ts": { "maxDuration": 60 },
    "src/app/api/v1/tasks/[id]/resume/route.ts": { "maxDuration": 60 },
    "src/app/api/v1/tasks/[id]/approve/route.ts": { "maxDuration": 60 },
    "src/app/api/v1/models/route.ts": { "maxDuration": 30 },
    "src/app/api/v1/github/files/route.ts": { "maxDuration": 30 },
    "src/app/api/v1/github/branches/route.ts": { "maxDuration": 30 }
  }
}
