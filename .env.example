# ============================================================
# Fury Agent — environment variables
# Copy to .env.local and fill in your own values.
# NEVER commit real secrets. Never prefix secrets with NEXT_PUBLIC_.
# ============================================================

# ---------- REQUIRED ----------
# PostgreSQL (Neon, Supabase, or self-hosted). Use a pooled TLS URL.
DATABASE_URL=postgresql://user:password@host:5432/fury_agent?sslmode=require

# Signs session cookies (JWT HS256). 32+ random bytes, base64url is fine.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# AES-256-GCM master key for provider API keys and GitHub tokens.
# 64 hex chars | base64-encoded 32 bytes | passphrase (SHA-256 derived).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- RECOMMENDED ----------
# Public origin of this deployment (used for OAuth redirect URIs).
APP_URL=http://localhost:3000

# ---------- OPTIONAL: GitHub ----------
# Create an OAuth App: https://github.com/settings/developers
# Callback URL must be {APP_URL}/api/v1/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Reserved for GitHub App installations (not required for OAuth mode).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ---------- OPTIONAL: storage ----------
# Optional object storage for artifacts. Not required by any current feature.
VERCEL_BLOB_READ_WRITE_TOKEN=

# NOTE: AI provider API keys are NOT set here.
# Each user configures their own providers in the app (Settings → Providers),
# encrypted at rest with ENCRYPTION_KEY.
